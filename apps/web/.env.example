# Google OAuth Client ID (Web application type) — https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=

# Optional: override the API base URL. Defaults to same-origin "/api" (works via Vite proxy
# in dev and the Firebase Hosting rewrite in production).
VITE_API_URL=

# Mirrors the backend's INSTAGRAM_MOCK_MODE — only used to show/hide the "Simulate comment"
# demo affordance in the UI. Keep in sync with apps/functions/.env.
VITE_INSTAGRAM_MOCK_MODE=true
