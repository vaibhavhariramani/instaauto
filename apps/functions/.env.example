# ── Server ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
COOKIE_DOMAIN=

# ── Database (Postgres — create a free project on Neon or Supabase) ─────
# Neon:     https://neon.tech
# Supabase: https://supabase.com
# DATABASE_URL: pooled connection (transaction mode, port 6543) — used by the running app.
# DIRECT_URL: session/direct connection (port 5432) — used only by `prisma migrate`, which
# needs prepared-statement support that the transaction pooler doesn't provide.
DATABASE_URL=
DIRECT_URL=

# ── Auth ─────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# 32-byte hex key for AES-256-GCM, generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ── Google Sign-In ────────────────────────────────────────────────────────
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=

# ── Instagram / Meta Graph API ──────────────────────────────────────────
# Set to false only once you have a reviewed Meta App + real Instagram Business account.
INSTAGRAM_MOCK_MODE=true
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_REDIRECT_URI=http://localhost:4000/api/instagram/oauth/callback

# ── Stripe ────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=
