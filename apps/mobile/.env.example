# Must match apps/functions' GOOGLE_CLIENT_ID exactly - it's what the
# backend verifies the Google ID token's audience against.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# A separate "iOS" type OAuth client (Google Cloud Console > Credentials >
# Create Credentials > OAuth client ID > iOS), bundle ID
# com.vaibhavhariramani.instaauto. Needed for the native Google Sign-In SDK;
# app.config.ts derives the required iosUrlScheme from this automatically.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Overrides the deployed production API base URL - only needed for local
# dev against `firebase emulators:start` / `npm run dev -w apps/functions`.
# EXPO_PUBLIC_API_URL=http://localhost:5001/instaautomation-1da00/us-central1/api
